{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mathraids",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-12",
  "routes": [
    {
      "pattern": "mathraids.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/admin/*", "/host/bosses/*"]
  },
  "r2_buckets": [
    {
      "binding": "BOSS_ASSETS",
      "bucket_name": "mathraids-bosses"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RAID_ROOMS",
        "class_name": "RaidRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaidRoom"]
    }
  ]
}
